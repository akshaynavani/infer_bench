# Reference server (read by infer_bench.server.config.ServerSettings)
INFER_BENCH_MODE=batched            # naive | batched
INFER_BENCH_BACKEND=simulated       # simulated | hf
INFER_BENCH_MAX_BATCH_SIZE=32
INFER_BENCH_BATCH_WAIT_MS=5
INFER_BENCH_STEP_OVERHEAD_MS=8
INFER_BENCH_PER_SEQ_COST_MS=1
INFER_BENCH_CPU_BOUND_FRACTION=0.5
INFER_BENCH_HF_MODEL_NAME=sshleifer/tiny-gpt2

# Load generator (read by the locustfile)
INFER_BENCH_TARGET=http://localhost:8000
INFER_BENCH_LOADGEN_BACKEND=native  # native | openai | openai-chat
INFER_BENCH_MODEL_NAME=simulated
INFER_BENCH_WORKLOAD=workloads/throughput.yaml
INFER_BENCH_LOADGEN_PROM_PORT=9646
# Bearer token for protected OpenAI-compatible endpoints (leave empty if unused)
INFER_BENCH_API_KEY=

# Grafana admin password for docker compose
GRAFANA_ADMIN_PASSWORD=change-me
